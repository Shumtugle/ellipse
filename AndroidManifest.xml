<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.shumtugle.ellipse"
    android:versionCode="18"
    android:versionName="0.6.1">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="33" />

    <!-- The weather, and nothing else, goes over the network. Where the phone
         is, roughly, and the charge of headphones are known only with the
         owner's leave, asked for in the settings. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Since Android 11 an application sees only
         the others it names here; a home screen names every application
         that has a front door, and nothing more. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@style/Ground">
        <!-- The home screen: one task that is never cleared from memory by
             choice, never shown among recent tasks, and never rebuilt for a
             turn of the phone or a change of keyboard. -->
        <activity
            android:name=".Home"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:resumeWhilePausing="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustPan"
            android:configChanges="keyboard|keyboardHidden|mcc|mnc|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode">
            <!-- What makes it a home screen in the system's eyes. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- A door in other home screens too, so it can be tried before
                 it is chosen. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The settings: reached only from the home screen itself, by a long
             press, and left for it by Back or Home. -->
        <activity
            android:name=".Tune"
            android:exported="false"
            android:label="@string/settings"
            android:theme="@style/Room"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode" />
    </application>
</manifest>
