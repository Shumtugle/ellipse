<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.shumtugle.ellipse"
    android:versionCode="20200"
    android:versionName="2.2.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="33" />

    <!-- A pull downward on bare screens may lower the phone's own shade,
         the notices or the quick settings, if the owner asks for it. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Uninstall, from an app's own menu on the home screen, is asked of
         the phone, which then asks the owner. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- The clock's weather: the phone's rough place, asked once, and the
         network to ask the weather of it. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To set a ground the home screen draws as the wallpaper. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- The phone shows its wallpaper only to an app that may read every file; asked for only when
         the owner wants the wallpaper kept in copies. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- The clock's headphones: their charge, while they are near. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Since Android 11 an application sees only the others it names here.
         A home screen names every application with a front door, and the
         everyday roles it looks for on first sight: the phone, messages,
         the browser, the camera and the rest. The installer refuses a query
         that names more than one action, type or scheme, so each role is
         asked for on its own. -->
    <queries>
        <!-- Packs of icons, by the calls they have long answered to. -->
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
        <intent>
            <action android:name="com.gau.go.launcherex.theme" />
        </intent>
        <intent>
            <action android:name="com.fede.launcher.THEME_ICONPACK" />
        </intent>
        <intent>
            <action android:name="com.anddoes.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Applications that offer widgets, so the shelf of widgets can
             show them even when they have no front door of their own. -->
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MESSAGING" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_GALLERY" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MARKET" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_EMAIL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CALENDAR" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MAPS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MUSIC" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_FILES" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@style/Ground">
        <!-- A new ground drawn and set while the phone sleeps, when the owner asks for it. -->
        <receiver
            android:name=".Turn"
            android:exported="false" />

        <!-- The power to lock the phone, and no other, for a gesture to use. -->
        <receiver
            android:name=".Warden"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/warden" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Files handed to another app to be sent: a copy, read-only, by name. -->
        <provider
            android:name=".Handed"
            android:authorities="io.github.shumtugle.ellipse.handed"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- The home screen: one task, never shown among recent tasks and
             never rebuilt for a turn of the phone or a change of keyboard. -->
        <activity
            android:name=".Home"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:resumeWhilePausing="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden"
            android:configChanges="keyboard|keyboardHidden|mcc|mnc|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- A door in other home screens too, so it can be tried before
                 it is chosen. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The night clock: the clock across the screen lying on its side, kept on. -->
        <activity
            android:name=".Night"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
        <!-- Locks the phone on a double tap of the empty home screen, once the
             owner turns it on among the phone's accessibility services. -->
        <service
            android:name=".Latch"
            android:label="@string/latch_name"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/latch" />
        </service>
        <!-- Knows which apps have notifications, for the dots on their icons,
             once the owner gives it that access. -->
        <service
            android:name=".Notices"
            android:label="@string/notices_name"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Where other applications ask to put a shortcut or a widget on
             the home screen. -->
        <activity
            android:name=".Pin"
            android:exported="true"
            android:theme="@style/Glass"
            android:excludeFromRecents="true"
            android:autoRemoveFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_APPWIDGET" />
            </intent-filter>
        </activity>
        <!-- The settings: reached from the home screen's own door on its
             screens, and left for it by Back or Home. -->
        <activity
            android:name=".Tune"
            android:exported="false"
            android:theme="@style/Room"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode" />
        <!-- The pages drawn as pages: the colour page and the weather. -->
        <activity
            android:name=".Folio"
            android:exported="false"
            android:theme="@style/Folio"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode" />
    </application>
</manifest>
