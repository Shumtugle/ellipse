<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window is glass: the wallpaper lies under it, the phone's bars
         float over it, and everything else is drawn by hand. -->
    <style name="Ground" parent="@android:style/Theme.Material.Wallpaper.NoTitleBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@color/clear</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/clear</item>
        <item name="android:navigationBarColor">@color/clear</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:colorEdgeEffect">@color/clear</item>
    </style>

    <!-- The settings: a room of its own, dark and solid, under the same
         clear bars. -->
    <style name="Room" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/room</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/clear</item>
        <item name="android:navigationBarColor">@color/clear</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorEdgeEffect">@color/clear</item>
    </style>
</resources>
